# 把这个文件复制成 .env (同目录), 填上真实凭据后再启动
#
# cp backend/.env.example backend/.env
#
# .env 在 .gitignore 里, 不会被提交

# 腾讯云 (tencent vendor)
TC_SECRET_ID=
TC_SECRET_KEY=

# LiteLLM 用的 Postgres
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# OpenAI
OPENAI_API_KEY=
# OPENAI_PROXY=http://user:pass@host:port  ← 国内服务器需走代理时配

# LiteLLM 管理端点 (/api/litellm/*) 的 x-api-key — 必配
# 未配置时后端一律 401 (fail-closed)。前端默认发 'dev-only-change-me'；
# 这里改成别的值时, 前端构建需配同值 VITE_LITELLM_API_KEY (frontend 与 litellm-ui-src 都支持)
API_KEY=dev-only-change-me

# Grok (xAI) — Management Key (≠ 推理 API key), console.x.ai → Settings → Management Keys 创建
GROK_MANAGEMENT_KEY=
# GROK_TEAM_ID=default
# GROK_PROXY=http://user:pass@host:port  ← 国内服务器需走代理时配
# GROK_TIMEZONE=Asia/Shanghai  ← usage analytics 按哪个时区切天, 默认跟其他 vendor 对齐

# Volcengine
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=

# UCloud
UCLOUD_PUBLIC_KEY=
UCLOUD_SECRET_KEY=
UCLOUD_PROJECT_ID=

# Wangsu
WANGSU_ACCESS_KEY=
WANGSU_SECRET_KEY=

# 账号密码登录的几个 (new-api-direct + road2all)
XHUB_USERNAME=
XHUB_PASSWORD=
ROAD2ALL_USERNAME=
ROAD2ALL_PASSWORD=

# 浏览器登录 vendor 自动登录 (kimi/apevon/blueshirt/bigmodel).
# 填了 → 02:30 预检 + 巡检 request_login 自动填表登录; 留空 → 弹浏览器人工登录
KIMI_USERNAME=
KIMI_PASSWORD=
APEVON_USERNAME=
APEVON_PASSWORD=
BLUESHIRT_USERNAME=
BLUESHIRT_PASSWORD=
BIGMODEL_USERNAME=
BIGMODEL_PASSWORD=

# ─── Ingest 落库系统 (PR1-PR5) ───
# DB_* 跟 LiteLLM 共用, 无需另配; schema 自动用 llm_usage_dashboard
# BILLING_DB_SCHEMA=llm_usage_dashboard

# xxl-job / 外部 trigger 鉴权 (空 = 关闭, 本地开发可空; 上线必须配!)
INGEST_TOKEN=

# 飞书 webhook (空 = 失败时只本地日志, 不推送)
FEISHU_WEBHOOK_URL=
# 多点部署区分节点标识, 单点不用配
INGEST_NODE_ID=

# ─── 自愈 Agent (巡检诊断) ───
# LLM 走 OpenAI 兼容 /chat/completions 或 Anthropic 兼容 /v1/messages
# (AGENT_LLM_API_STYLE=openai|anthropic, 不配时按 BASE_URL 含 /anthropic 自动判断).
# GLM coding plan 订阅只覆盖 Anthropic 端点 (同 key 两个端点两种额度池):
#   AGENT_LLM_API_STYLE=anthropic
#   AGENT_LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
#   AGENT_LLM_MODEL=glm-5.3                    ← 思考型, AGENT_LLM_MAX_TOKENS 默认 16384 别调小
#   AGENT_LLM_API_KEY=<GLM key>
# 其他 OpenAI 兼容平台示例 (按量付费, 国内直连):
#   DeepSeek: AGENT_LLM_BASE_URL=https://api.deepseek.com                 AGENT_LLM_MODEL=deepseek-chat
#   Kimi:     AGENT_LLM_BASE_URL=https://api.moonshot.cn/v1               AGENT_LLM_MODEL=kimi-k2-0905-preview
#   Qwen:     AGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AGENT_LLM_MODEL=qwen-plus
#   GLM v4:   AGENT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4     AGENT_LLM_MODEL=glm-4-flash (免费档; 付费档需账户余额)
# 不配 AGENT_LLM_API_KEY 时回落 OPENAI_API_KEY (注意: 本项目现有 key 是账单只读 scope, 调不了 chat)
# AGENT_LLM_TIMEOUT=120
# AGENT_LLM_MAX_TOKENS=16384  ← anthropic 风格必配够大, 思考模型 thinking 计入输出
# AGENT_LLM_MAX_TURNS=8
# 巡检总开关 (0 = 不注册巡检 cron); 手动 POST /api/ingest/agent/patrol 不受此开关影响
# AGENT_PATROL_ENABLED=1
# AGENT_PATROL_MAX_ACTIONS=4        ← 每轮巡检全局动作上限
# AGENT_PATROL_MAX_WINDOW_DAYS=14   ← 重拉窗口上限 (blueshirt 固定 13 天 retention)
# AGENT_PATROL_VERIFY_TIMEOUT=600   ← 单动作结果轮询上限 (秒)
# AGENT_PATROL_DEADLINE=1500        ← 巡检总时长上限 (秒), 超时动作标 still_running 下轮收尾
# request_login 自动失败转人工时, 卡片里给人工的 noVNC 地址
# AGENT_NOVNC_URL=http://your-server:6080
