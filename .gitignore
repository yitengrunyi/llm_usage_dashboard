backend/config/discounts.json
backend/config/sessions/*
!backend/config/sessions/.gitkeep
backend/config/sessions.bak*

# playwright MCP 测试产物
.playwright-mcp/

# Claude Code 本地配置（launch.json 可共享，settings.local.json 不入库）
.claude/settings.local.json
.claude/worktrees/

# 对账/验证脚本的原始数据转储（大文件 + 含上游账单数据，不入库）
backend/scripts_verify/

# 网宿控制台 key 筛选配置（运行时数据、含真实网关名，同 discounts.json 不入库）
backend/wangsu_tokens.json

# 公司内部运维文档（交接/生产环境/对账报告等）— 本地保留, 不随公开仓库发布
